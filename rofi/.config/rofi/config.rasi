/*
 * Rofi launcher with a random banner image on the left (Dracula, soft corners).
 * Start it with launcher.sh (it picks the random image); plain `rofi -show drun`
 * also works, you just get an empty image panel.
 *
 * Install:  ~/.config/rofi/config.rasi  and  ~/.config/rofi/launcher.sh
 * Layout maths (keep in sync with launcher.sh):
 *   window height 480 - padding 2*14 - border 2*1  = 450 px
 *   image panel 300 x 450  ->  launcher.sh crops images to 600 x 900 (2x, sharp on HiDPI)
 */

configuration {
    modi:                 "drun";
    show-icons:           true;
    display-drun:         " Apps";
    drun-display-format:  "{name}";
    matching:             "fuzzy";
    disable-history:      false;
    hover-select:         true;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
}

* {
    /* palette, same values as Style.qml */
    bg:           #282A36;
    bg-panel:     #282A36EB;
    surface:      #44475A;
    surface-soft: #44475A99;
    fg:           #F8F8F2;
    muted:        #6272A4;
    accent:       #BD93F9;
    accent-soft:  #BD93F92E;
    accent-line:  #BD93F999;
    red:          #FF5555;
    red-soft:     #FF55552E;
    outline:      #F8F8F21F;

    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         center;
    anchor:           center;
    width:            900px;
    height:           480px;
    padding:          14px;
    background-color: @bg-panel;
    border:           1px;
    border-color:     @outline;
    border-radius:    22px;
}

mainbox {
    orientation: horizontal;
    spacing:     14px;
    children:    [ imagebox, content ];
}

/* ---------- left: banner image (set by launcher.sh) ---------- */
imagebox {
    expand:           false;
    width:            300px;
    background-color: @surface;
    border-radius:    14px;
    children:         [ dummy ];
}

dummy {
    expand:           true;
    background-color: transparent;
}

/* ---------- right: search + list ---------- */
content {
    orientation: vertical;
    spacing:     12px;
    children:    [ inputbar, message, listview ];
}

inputbar {
    spacing:          12px;
    padding:          10px 12px;
    background-color: @surface-soft;
    border:           1px;
    border-color:     @outline;
    border-radius:    12px;
    children:         [ prompt, entry, num-filtered-rows, textbox-num-sep, num-rows ];
}

prompt {
    padding:          4px 12px;
    background-color: @accent;
    text-color:       @bg;
    border-radius:    8px;
    vertical-align:   0.5;
}

entry {
    placeholder:       "Launch application…";
    placeholder-color: @muted;
    text-color:        @fg;
    vertical-align:    0.5;
}

num-filtered-rows, num-rows {
    expand:         false;
    text-color:     @muted;
    vertical-align: 0.5;
}

textbox-num-sep {
    expand:         false;
    str:            "/";
    text-color:     @muted;
    vertical-align: 0.5;
}

message {
    padding:          10px 14px;
    background-color: @surface-soft;
    border-radius:    12px;
}

textbox {
    text-color: @fg;
}

listview {
    expand:       true;
    lines:        7;
    columns:      1;
    fixed-height: true;
    dynamic:      true;
    cycle:        true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       6px 12px;
    spacing:       14px;
    border:        1px;
    border-color:  transparent;
    border-radius: 12px;
    orientation:   horizontal;
}

element-icon {
    size:             2em;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent,
element alternate.urgent {
    text-color: @red;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.normal {
    background-color: @accent-soft;
    border-color:     @accent-line;
    text-color:       @fg;
}

element selected.urgent {
    background-color: @red-soft;
    border-color:     @red;
    text-color:       @red;
}

element selected.active {
    background-color: @accent-soft;
    border-color:     @accent-line;
    text-color:       @accent;
}
